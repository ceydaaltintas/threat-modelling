# ---------------------------------------------------------------------------
# Tehdit Modelleme Platformu - ornek ortam degiskenleri
# Bu dosyayi ".env" olarak kopyalayin ve degerleri doldurun.
#   cp .env.example .env
# ".env" dosyasi git'e girmez (bkz. .gitignore).
# ---------------------------------------------------------------------------

# --- Urun ---
# Arayuzde gorunen urun adi.
APP_NAME=Tehdit Modelleme Platformu
# development | production
APP_ENV=development

# --- Veritabani (docker compose icindeki "db" servisi) ---
POSTGRES_USER=threatmodel
POSTGRES_PASSWORD=threatmodel
POSTGRES_DB=threatmodel
# Backend konteyneri icinden gorunen adres. Host'tan baglanmak icin: localhost:5433
DATABASE_URL=postgresql+psycopg://threatmodel:threatmodel@db:5432/threatmodel

# --- Portlar (host tarafi) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5433

# --- Frontend -> Backend ---
# Tarayicidan cagrilan adres (SSE dahil).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Tehdit Modelleme Platformu

# --- LLM saglayici (Asama 1'de kullanilacak) ---
# Varsayilan oneri: Gemini'nin yerel (native) istemcisi; yapilandirilmis cikti
# ve gorsel/PDF girdisi daha guvenilir.
LLM_PROVIDER=gemini_native
# Model adini SIZ secin: ucretsiz katmanlarin model adlari ve limitleri
# degisir. Saglayicinizin guncel model listesine bakin (README bolum 2).
# Gemini icin hizli ve ucretsiz bir baslangic: gemini-2.5-flash
LLM_MODEL=
LLM_API_KEY=
# Alternatifler (birini acin, yukaridakini kapatin). Kisa yol saglayici
# adlari LLM_BASE_URL'i otomatik doldurur:
# LLM_PROVIDER=groq
# LLM_PROVIDER=openrouter
# LLM_PROVIDER=ollama
# ... veya elle:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
#
# stub: ag erismeyen, sabit yanit donen gelistirme saglayicisi. Demo icin
# DEGILDIR; yalnizca testler ve boru hattini anahtarsiz denemek icin.
# LLM_PROVIDER=stub
LLM_TEMPERATURE=0.2
# Tek cagri icin yanit token siniri. 0 = saglayicinin varsayilani, ki bu
# genelde cok dusuktur (Groq 3072) ve sistem modeli yarida kesilir.
# Kesilme olursa adim hata verir ve bu degeri yukseltmenizi soyler.
LLM_MAX_OUTPUT_TOKENS=16000

# --- Demo guvenligi (Asama 5) ---
# false | true | strict
# true  : ayni istem icin kayitli yanit dondurulur, yoksa canli cagri yapilir.
# strict: kayit yoksa adim hata verir (internetsiz demo garantisi).
DEMO_REPLAY=false

# --- Dokuman okuma ---
# OCR varsayilan olarak KAPALI. Yalnizca LLM gorsel okuyamiyorsa acin.
OCR_ENABLED=false
MAX_UPLOAD_MB=25

# --- Risk esikleri (olasilik x etki, 1-25) ---
RISK_THRESHOLD_LOW=4
RISK_THRESHOLD_MEDIUM=9
RISK_THRESHOLD_HIGH=16
